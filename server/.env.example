# ── Database ──
DATABASE_URL=postgresql+asyncpg://dalia:dalia@localhost:5432/dalia

# ── JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Riot API ──
RIOT_API_KEY=
RIOT_PLATFORM=euw1

# ── Reverse proxy ──
# Behind Railway, Tailscale Funnel or nginx, list the proxy addresses whose
# X-Forwarded-For header can be trusted ("*" when the app is not reachable
# directly). Without it every user shares the proxy IP and its rate limits.
# Railway is detected automatically through RAILWAY_ENVIRONMENT.
# FORWARDED_ALLOW_IPS=*
